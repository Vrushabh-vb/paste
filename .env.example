# ─── Cloudflare R2 (required) ───────────────────────────
# Cloudflare dashboard → R2 → your bucket, and R2 → Manage API tokens (Object Read & Write is enough).
# The bucket can stay PRIVATE: downloads go through /api/file, which checks expiry and hands out short-lived signed links.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ─── Cleanup cron (required in production) ──────────────
# Any long random string (e.g. `openssl rand -hex 32`). Vercel sends it to /api/cron/cleanup automatically.
# Without it the cleanup endpoint stays disabled and expired files are never deleted.
CRON_SECRET=

# ─── Abuse protection (optional but recommended) ────────
# Free Upstash Redis (https://console.upstash.com). Makes rate limits and the daily upload cap
# shared across all serverless instances. Without it, limits are per-instance (best effort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Total MB of uploads accepted per UTC day across everyone. Default 3072 (3 GB): files live ~1-2 days on disk,
# so peak storage stays around 6 GB, inside R2's free 10 GB.
# DAILY_UPLOAD_CAP_MB=3072

# ─── Optional ───────────────────────────────────────────
# Shows a "Contact" link in the footer (where abuse reports go).
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

NEXT_TELEMETRY_DISABLED=1
